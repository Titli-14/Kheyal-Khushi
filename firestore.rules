rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own profile doc (already used by auth.js signup)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Cart: doc id == uid, only that user can read/write it
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Wishlist: doc id == uid, only that user can read/write it
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders: anyone signed in can create an order for themselves;
    // only the owner can read it; nobody can edit/delete after creation
    // (that should go through an admin backend later).
    match /orders/{orderId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update, delete: if false;
    }
    // Contact form: anyone (even signed-out visitors) can submit a
    // message. Nobody can read/edit/delete from the client — you'll
    // review these in the Firebase console.
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
